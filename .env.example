# Copy to .env.local for a local installation. Never commit real secrets.
SKYT_ENV=development
SKYT_AUTH_ENABLED=true
SKYT_AUTH_MODE=local
# Only for remote/server deployments: set SKYT_AUTH_MODE=token and provide this outside the repository.
# SKYT_ACCESS_TOKEN=
SKYT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SKYT_MAX_REQUEST_BYTES=8388608
SKYT_RATE_LIMIT_REQUESTS=120
SKYT_RATE_LIMIT_WINDOW_SECONDS=60
SKYT_TASK_POLL_SECONDS=0.5
SKYT_TASK_LEASE_SECONDS=300
SKYT_TASK_MAX_ATTEMPTS=3
SKYT_DEFAULT_WORKSPACE=./workspace

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=skyt_db
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
